{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentauth.dev/schemas/authorization-decision.schema.json",
  "title": "AgentAuth Authorization Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reason_codes",
    "policy_version"
  ],
  "properties": {
    "decision": {
      "enum": ["allow", "deny", "step_up"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "matched_capability_id": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
