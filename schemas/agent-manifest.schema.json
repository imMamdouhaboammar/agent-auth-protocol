{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentauth:schema:agent-manifest:v1",
  "title": "AgentAuth Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "publisher",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supported_integrations": {
      "type": "array",
      "items": {
        "enum": [
          "api",
          "mcp",
          "native_browser",
          "legacy_browser"
        ]
      },
      "uniqueItems": true
    },
    "metadata_uri": {
      "type": "string",
      "format": "uri"
    }
  }
}
