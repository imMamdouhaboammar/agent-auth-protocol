{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentauth.dev/schemas/trust-domain.schema.json",
  "title": "AgentAuth Trust Domain Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trust_domain",
    "protocol_versions_supported",
    "authorities",
    "actor_types_supported",
    "proof_methods_supported",
    "metadata_expires_at"
  ],
  "properties": {
    "trust_domain": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "protocol_versions_supported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "0.2" },
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "actor_types_supported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "ai_agent" }
    },
    "proof_methods_supported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["dpop", "mtls"]
      }
    },
    "attestation_formats_supported": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "federation_metadata_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "jwks_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "administrative_contact": {
      "type": "string",
      "format": "uri"
    },
    "metadata_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
