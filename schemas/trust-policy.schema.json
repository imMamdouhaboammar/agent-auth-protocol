{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentauth.dev/schemas/trust-policy.schema.json",
  "title": "AgentAuth Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_version",
    "accepted_trust_domains",
    "accepted_proof_methods",
    "max_metadata_age_seconds",
    "max_token_lifetime_seconds",
    "unknown_mandatory_semantics"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "accepted_trust_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "accepted_proof_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["dpop", "mtls"]
      }
    },
    "require_attestation": {
      "type": "boolean"
    },
    "accepted_attestation_verifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "accepted_assurance_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "max_attestation_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_metadata_age_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "max_token_lifetime_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "unknown_mandatory_semantics": {
      "const": "reject"
    }
  }
}
