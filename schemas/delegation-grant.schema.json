{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentauth:schema:delegation-grant:v1",
  "title": "AgentAuth Delegation Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "issuer",
    "subject",
    "actor_agent_issuer",
    "actor_agent_id",
    "capabilities",
    "expires_at",
    "status"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "subject": {
      "type": "object",
      "required": ["type", "issuer", "id"],
      "properties": {
        "type": {
          "enum": ["human", "organization", "workload", "ai_agent"]
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "actor_agent_issuer": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "actor_agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_grant_id": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "purpose": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://agentauth.dev/schemas/capability.schema.json"
      }
    },
    "not_before": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "status": {
      "enum": ["requested", "pending_approval", "active", "suspended", "denied", "revoked", "expired"]
    }
  }
}
