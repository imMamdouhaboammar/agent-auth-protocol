{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentauth.dev/schemas/provider-metadata.schema.json",
  "title": "AgentAuth Provider Resource Metadata Extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "actor_types_supported",
    "profiles_supported",
    "proof_methods_supported"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.2"
    },
    "actor_types_supported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ai_agent"]
      }
    },
    "profiles_supported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AA-[A-Z0-9-]+-[0-9]+$"
      }
    },
    "proof_methods_supported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["dpop", "mtls"]
      }
    },
    "authorization_details_types_supported": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "agent_signup_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "agent_session_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "agent_account_management_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "required_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AA-[A-Z0-9-]+-[0-9]+$"
      }
    }
  }
}
